rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isActive() {
      return isSignedIn() && myProfile().status == 'active';
    }
    function isAdmin() {
      return isSignedIn() && myProfile().role == 'admin';
    }
    // Accountant: a read-only oversight role that can see every staff
    // member's data across all branches, like an admin, but cannot manage
    // staff accounts or store settings.
    function isAccountant() {
      return isSignedIn() && myProfile().role == 'accountant';
    }
    // Manager: an active staff member who is not themself someone else's
    // sub-user — they "own" a branch and can create/see their own sub-users.
    function isManagerRole() {
      return isSignedIn() && myProfile().role == 'staff' && myProfile().get('managerId', null) == null;
    }
    // The id that groups "this person's whole branch" together: a manager's
    // own uid, or a sub-user's manager's uid.
    function myBranchOwnerId() {
      return myProfile().get('managerId', null) != null ? myProfile().managerId : request.auth.uid;
    }
    function myOwnerId() {
      return myProfile().ownerId;
    }
    // True if a document belongs to the same store/tenant as the caller.
    function ownedByMe(data) {
      return isActive() && data.ownerId == myOwnerId();
    }
    // True if this document is the caller's own sub-store record — used for
    // Products/Stock In/Stock Out/Sales, where each staff member's data is
    // isolated from every other staff member's, and only an admin can see
    // everyone's combined.
    function isMySubData(data) {
      return isSignedIn() && data.subOwnerId == request.auth.uid;
    }
    // True if this record belongs to the caller's own branch — this only
    // ever broadens access for the manager who OWNS the branch (their own
    // records plus every sub-user they created). A sub-user never gets this:
    // it must stay scoped to isMySubData only, or siblings could see each
    // other's data.
    function isMyBranchData(data) {
      return isManagerRole() && data.get('branchOwnerId', null) == request.auth.uid;
    }
    // Read access: admin, accountant (oversight), the record's own creator,
    // or (for a manager) anyone in their branch.
    function canReadSubData(data) {
      return ownedByMe(data) && (isAdmin() || isAccountant() || isMySubData(data) || isMyBranchData(data));
    }
    // Write access: admin, the record's own creator, or (for a manager)
    // anyone in their branch — accountant is read-only and never modifies
    // another branch's data.
    function canWriteSubData(data) {
      return ownedByMe(data) && (isAdmin() || isMySubData(data) || isMyBranchData(data));
    }

    // --- users ---
    // Anyone signed in can read/bootstrap their own profile.
    // An active admin can create/manage any staff profile in their store.
    // A branch manager can create/manage only the sub-users they created.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || ownedByMe(resource.data));
      allow create: if isSignedIn() && (
        request.auth.uid == uid ||
        (isAdmin() && request.resource.data.ownerId == myOwnerId()) ||
        (isManagerRole() && request.resource.data.ownerId == myOwnerId() && request.resource.data.managerId == request.auth.uid)
      );
      allow update: if isSignedIn() && (
        request.auth.uid == uid ||
        (isAdmin() && ownedByMe(resource.data)) ||
        (isManagerRole() && ownedByMe(resource.data) && resource.data.managerId == request.auth.uid)
      );
      allow delete: if false;
    }

    // --- per-user sub-store data ---
    // "resource == null ||" guards reads that check a document which may not
    // exist yet (e.g. a product referenced by a sale that was later deleted) —
    // without it, Firestore denies the read outright instead of just finding nothing.
    // Each of these requires request.resource.data.subOwnerId == caller's own
    // uid on create, so a record is always stamped with its true creator.
    match /products/{id} {
      allow read: if resource == null || canReadSubData(resource.data);
      allow update, delete: if canWriteSubData(resource.data);
      allow create: if isActive() && request.resource.data.ownerId == myOwnerId() && request.resource.data.subOwnerId == request.auth.uid && request.resource.data.branchOwnerId == myBranchOwnerId();
    }
    match /stockIn/{id} {
      allow read: if resource == null || canReadSubData(resource.data);
      allow update, delete: if canWriteSubData(resource.data);
      allow create: if isActive() && request.resource.data.ownerId == myOwnerId() && request.resource.data.subOwnerId == request.auth.uid && request.resource.data.branchOwnerId == myBranchOwnerId();
    }
    match /stockOut/{id} {
      allow read: if resource == null || canReadSubData(resource.data);
      allow update, delete: if canWriteSubData(resource.data);
      allow create: if isActive() && request.resource.data.ownerId == myOwnerId() && request.resource.data.subOwnerId == request.auth.uid && request.resource.data.branchOwnerId == myBranchOwnerId();
    }
    match /sales/{id} {
      allow read: if resource == null || canReadSubData(resource.data);
      allow create: if isActive() && request.resource.data.ownerId == myOwnerId() && request.resource.data.subOwnerId == request.auth.uid && request.resource.data.branchOwnerId == myBranchOwnerId();
      // An admin, or the staff member who created the sale, can edit or delete it.
      allow update, delete: if canWriteSubData(resource.data);
    }

    // --- tenant-shared data (same for everyone on the team) ---
    match /customers/{id} {
      allow read: if resource == null || ownedByMe(resource.data);
      allow update, delete: if ownedByMe(resource.data);
      allow create: if isActive() && request.resource.data.ownerId == myOwnerId();
    }
    match /customerDebts/{id} {
      allow read: if resource == null || ownedByMe(resource.data);
      allow update, delete: if false;
      allow create: if isActive() && request.resource.data.ownerId == myOwnerId();
    }
    match /branches/{id} {
      allow read: if resource == null || ownedByMe(resource.data);
      allow update, delete: if ownedByMe(resource.data);
      allow create: if isActive() && request.resource.data.ownerId == myOwnerId();
    }
    match /departments/{id} {
      allow read: if resource == null || ownedByMe(resource.data);
      allow update, delete: if ownedByMe(resource.data);
      allow create: if isActive() && request.resource.data.ownerId == myOwnerId();
    }

    // --- theme management (one doc per store, keyed by ownerId) ---
    match /themeSettings/{ownerIdKey} {
      allow read: if isSignedIn() && myOwnerId() == ownerIdKey;
      allow create, update: if isActive() && myOwnerId() == ownerIdKey;
      allow delete: if false;
    }

    match /posSettings/{ownerIdKey} {
      allow read: if isSignedIn() && myOwnerId() == ownerIdKey;
      allow create, update: if isActive() && isAdmin() && myOwnerId() == ownerIdKey;
      allow delete: if false;
    }

    // --- POS register sessions (each "Close Daily" finalizes one) ---
    match /posSessions/{id} {
      allow read: if resource == null || canReadSubData(resource.data);
      allow create: if isActive() && request.resource.data.ownerId == myOwnerId() && request.resource.data.branchOwnerId == myBranchOwnerId();
      allow update, delete: if false;
    }

    // --- audit log (append-only trail of who changed what) ---
    match /auditLog/{id} {
      allow read: if isAdmin() && ownedByMe(resource.data);
      allow create: if isActive() && request.resource.data.ownerId == myOwnerId() && request.resource.data.subOwnerId == request.auth.uid;
      allow update, delete: if false;
    }

    // --- active sessions (one doc per signed-in device/tab) ---
    match /sessions/{sessionId} {
      // A user can read/write their own session (heartbeat, and to notice a
      // forced logout). An admin can read/manage every session for their store.
      allow read: if isSignedIn() && (request.auth.uid == resource.data.uid || (isAdmin() && ownedByMe(resource.data)));
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.ownerId == myOwnerId();
      allow update: if isSignedIn() && (
        (request.auth.uid == resource.data.uid && request.resource.data.uid == resource.data.uid) ||
        (isAdmin() && ownedByMe(resource.data))
      );
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.uid || (isAdmin() && ownedByMe(resource.data)));
    }
  }
}
